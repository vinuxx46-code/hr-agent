# Copy to backend/.env and fill in. NEVER commit the real .env file.

# --- Required to enable HR endpoints -------------------------------------
# Protects every endpoint that exposes candidate PII. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If this is unset the HR API returns 503 and serves no candidate data.
HR_API_KEY=

# --- AI ------------------------------------------------------------------
GEMINI_API_KEY=

# Set to "true" to let the model generate interview questions.
INTERVIEW_AI_GENERATION=false

# --- CORS ----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Defaults to local dev hosts. Never use "*" - it exposes candidate PII.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview/staging domains.
ALLOWED_ORIGIN_REGEX=https://.*\.e2b\.app

# --- Server --------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Upload limits (megabytes) -------------------------------------------
MAX_RESUME_MB=10
MAX_ARCHIVE_MB=50
MAX_ARCHIVE_UNCOMPRESSED_MB=200
MAX_ARCHIVE_ENTRIES=200
MAX_VIDEO_MB=500

# --- Email ---------------------------------------------------------------
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
HR_EMAIL=
